# コピーして .env を作ると mise が自動で読み込む（すべて任意。未設定なら既定値）
# 待ち受けアドレスはループバック（127.0.0.1 / ::1 / localhost）のみ指定できる

# --- api（Task API。DB を持つ） ---
API_ADDR=127.0.0.1:8080
API_DB_PATH=data/taskboard.db
# 他のアプリから API を使うときに設定（16文字以上。例: openssl rand -hex 32）
API_KEY=
# ブラウザから API を直接呼ぶ他のアプリのオリジン（カンマ区切り）
API_CORS_ORIGINS=
# 振り返りの抽出を頼む insight の URL
API_INSIGHT_URL=http://127.0.0.1:8081

# --- web（画面アプリ。DB を持たず api を呼ぶ） ---
WEB_ADDR=127.0.0.1:3000
WEB_API_URL=http://127.0.0.1:8080
# API_KEY を設定した場合は同じ値を指定する
WEB_API_KEY=

# --- insight（抽出 API） ---
INSIGHT_ADDR=127.0.0.1:8081
